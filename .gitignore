# 依赖与构建产物（真正的交付物是根目录的单文件 HTML）
node_modules/
dist/
.tmp/
*.log

# 本地试跑产物
out/
samples-out/
# 试跑/实验产出的图片与中间文件（文档不在这里——历史记录已归档到 docs/history/）
output/
# 图标管线的审图产物（SVG / PNG 预览 / 生成的清单）：可再生，不入库。
# 进库的是"形状定义"（pixel-shapes.mjs / svg-shapes.mjs）与接线结果（src/app/ui/icons.ts）
tool/icons/.out/
# 截图工具（tool/shoot.mjs）的输出：用于"看图改 UI"时与参考图并排比较，不入库
.tmp-shots/
# Agent 快速上手（tool/quickstart.mjs）的产出：全部是生成物，不入库
.quickstart/
.git-msg.tmp

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
