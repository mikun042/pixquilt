{
  "name": "pixel-art-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "像素画工作台（重写版）：图片→像素画转换、逐格精修、拼豆图纸与游戏资产批量导出；agent 可直接通过 CLI 与页内 API 驱动",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node tool/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/test/*.test.ts\"",
    "describe": "node tool/describe.mjs --write",
    "selftest": "node tool/artc.mjs --selftest",
    "quickstart": "node tool/quickstart.mjs",
    "e2e": "node tool/e2e.mjs",
    "e2e:picker": "node tool/e2e-picker.mjs",
    "e2e:slider": "node tool/e2e-slider.mjs",
    "e2e:regressions": "node tool/e2e-regressions.mjs",
    "shoot": "node tool/shoot.mjs",
    "ref:analyze": "node tool/ref-analysis.mjs",
    "dev": "node tool/serve.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && node tool/artc.mjs --selftest && npm run e2e && npm run e2e:picker && npm run e2e:slider && npm run e2e:regressions && npm run e2e:pdf",
    "e2e:pdf": "node tool/e2e-pdf.mjs",
    "shot:el": "node tool/shot-el.mjs",
    "probe": "node tool/probe.mjs",
    "verify:sections": "node tool/verify-sections.mjs",
    "bench": "node tool/bench.mjs",
    "icons:sync": "node tool/icons/pixel-sync.mjs && node tool/icons/svg-sync.mjs",
    "icons:check": "node tool/icons/pixel-sync.mjs --check && node tool/icons/svg-sync.mjs --check",
    "icons:gen": "node tool/icons/pixel-gen.mjs",
    "icons:preview": "node tool/icons/preview-svg.mjs",
    "icons:16": "node tool/icons/preview-16.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  }
}
